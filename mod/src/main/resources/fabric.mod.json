{
  "schemaVersion": 1,
  "id": "wynnvoicechat",
  "version": "${version}",
  "name": "WynnVoiceChat",
  "description": "Voice chat for Wynncraft parties, guilds and friends.",
  "icon": "assets/wynnvoicechat/icon.png",
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["wynnvoicechat.mod.VoiceMod"],
    "voicechat": ["wynnvoicechat.mod.svc.VoiceChatPlugin"]
  },
  "mixins": ["wynnvoicechat.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "voicechat": "*",
    "minecraft": "1.21.11",
    "java": ">=21"
  },
  "custom": {
    "mc-publish": {
      "modrinth": "EqqrBoe4",
      "dependencies": ["voicechat@>=2.6.0(required){modrinth:simple-voice-chat}"]
    }
  }
}
